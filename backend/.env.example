# Copia a .env y ajusta los valores.
PORT=3000

# Secreto de sesión. Usa una cadena larga y aleatoria en producción.
SESSION_SECRET=change_me_to_a_long_random_string
# "true" solo si sirves por HTTPS.
COOKIE_SECURE=false

# Credenciales de acceso a la app.
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# Google Gemini (generación de dieta y rutinas).
# Sin GEMINI_API_KEY la app usa el planner local + recetario.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fuente externa de recetas (opcional): none | themealdb
# TheMealDB no trae macros: se estiman localmente.
RECIPE_PROVIDER=none
# Key de TheMealDB (la de prueba es "1").
RECIPE_API_KEY=
