# Copia a .env y ajusta los valores.
PORT=3000

# Secreto de sesión. Usa una cadena larga y aleatoria en producción.
SESSION_SECRET=change_me_to_a_long_random_string
# "true" solo si sirves por HTTPS.
COOKIE_SECURE=false
# Carpeta donde se guardan las sesiones (persisten entre reinicios).
SESSION_STORE_PATH=./data/sessions

# Credenciales de acceso a la app.
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# Google Gemini (generación de dieta y rutinas).
# Sin GEMINI_API_KEY la app usa el planner local + recetario.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Fuente externa de recetas: themealdb | none
# TheMealDB usa el test key "1" (endpoints V1, gratis, solo dev/uso personal).
# Para una app pública conviene una key de supporter. No trae macros: se estiman.
RECIPE_PROVIDER=themealdb
# Key de TheMealDB (la de prueba es "1"; usa tu key de supporter si la tienes).
RECIPE_API_KEY=
